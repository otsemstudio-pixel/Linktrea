# Copie ce fichier en .env et renseigne tes propres valeurs.
# Ne jamais mettre la clé service_role ici (ni nulle part côté client) —
# uniquement l'URL du projet et la clé anon/publishable, prévues pour être
# exposées côté navigateur.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# 'local' : localStorage uniquement, pour développer sans réseau (défaut).
# 'supabase' : les deux variables ci-dessus doivent être renseignées.
VITE_STORAGE_MODE=local

# Optionnelle : clé de SITE Turnstile (Cloudflare, gratuite) pour le CAPTCHA
# invisible du formulaire de connexion. Sans elle, /login fonctionne quand
# même, juste sans CAPTCHA. La clé SECRÈTE correspondante ne va jamais ici —
# elle se configure côté dashboard Supabase (Authentication → Attack
# Protection), pas dans le code client.
VITE_TURNSTILE_SITE_KEY=
